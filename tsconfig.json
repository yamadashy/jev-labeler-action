{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "target": "es2022",
    "noEmit": true,
    "rootDir": ".",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["es2023"],
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"]
}
